# Kitchen-sink plugin credentials.
# Copy to .env and fill with real values. .env is gitignored.
# All vars must be VITE_ prefixed to be exposed to the client bundle.

# --- Rollbar (packages/plugin-rollbar) ---
# Required if the rollbar plugin is enabled in caper.config.ts.
VITE_ROLLBAR_ACCESS_TOKEN=

# --- Google Analytics (packages/plugin-google-analytics) ---
# GA4 Measurement ID, e.g. G-XXXXXXXXXX. Comma-separate for multiple.
VITE_GOOGLE_ANALYTICS_TRACKING_ID=

# --- Firebase plugin (packages/plugin-firebase) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
