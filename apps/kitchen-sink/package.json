{
  "name": "caper-kitchen-sink",
  "version": "0.1.0",
  "description": "Examples of Caper Features (V8)",
  "main": "index.html",
  "scripts": {
    "clean": "rimraf dist .assetpack .cache",
    "clean:dev": "rimraf dist .cache",
    "start": "pnpm clean && caper start",
    "dev": "pnpm clean:dev && caper dev",
    "build": "pnpm clean && caper build",
    "types": "tsc",
    "preview": "pnpm clean && caper preview",
    "lint": "eslint \"src/**/*.ts\"",
    "lint-fix": "eslint \"src/**/*.ts\" --fix",
    "visualize": "npx vite-bundle-visualizer -c vite.config.mjs",
    "audio:vo:en": "texttospeech assets/audio{m}/vo/en --sheet-name=\"Intro EN\"",
    "audio:vo:fr": "texttospeech assets/audio{m}/vo/fr --sheet-name=\"Intro FR\"",
    "audio:captions:en": "node ../framework/cli.mjs audio captions src/assets/audio/en assets/audio{m}/vo/en",
    "audio:captions:fr": "node ../framework/cli.mjs audio captions src/assets/audio/fr assets/audio{m}/vo/fr",
    "vo:generate": "node ../framework/cli.mjs vo generate \"./src/locales, ./assets/locales\"",
    "spritesheets": "node assets/images/export_spritesheets",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/assets/static/caper.png"
  },
  "author": "Anthony Sapp <anthony@anthonysapp.dev>",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@types/dat.gui": "^0.7.13"
  },
  "dependencies": {
    "@assetpack/core": "^1.7.0",
    "@caperjs/plugin-crunch": "workspace:*",
    "@caperjs/plugin-google-analytics": "workspace:*",
    "@caperjs/plugin-rive": "workspace:*",
    "@caperjs/plugin-rollbar": "workspace:*",
    "@caperjs/plugin-firebase": "workspace:*",
    "@pixi/layout": "^3.2.0",
    "@pixi/sound": "^6.0.1",
    "@vite-pwa/assets-generator": "^1.0.0",
    "dat.gui": "^0.7.9",
    "@caperjs/core": "workspace:*",
    "firebase": "^10.12.2",
    "gsap": "^3.15.0",
    "npm-run-all": "4.1.5",
    "pixi.js": "8.19.0",
    "rimraf": "5.0.5",
    "stats.js": "0.17.0",
    "vite": "^8.0.7",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-singlefile": "^2.3.2",
    "vite-plugin-static-copy": "^4.0.1",
    "vite-plugin-wasm": "^3.6.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.4.0"
  },
  "packageManager": "pnpm@9.3.0"
}
