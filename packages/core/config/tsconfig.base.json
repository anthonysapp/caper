{
  "compilerOptions": {
    "rootDir": "${configDir}",
    "baseUrl": "${configDir}",
    "paths": {
      "@/*": ["${configDir}/src/*"]
    },
    "types": ["vite/client", "vite-plugin-pwa/client", "@caper-engine/core/client"],
    "outDir": "${configDir}/dist",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "strictPropertyInitialization": false,
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true
  },
  "include": ["${configDir}/caper.config.ts", "${configDir}/src", "${configDir}/src/**/*.d.ts"],
  "exclude": ["${configDir}/.cache", "${configDir}/node_modules", "${configDir}/dist"]
}
