{
  "name": "@caperjs/solid",
  "description": "Declarative Solid JSX view layer for Caper",
  "keywords": [
    "solid",
    "solid-js",
    "jsx",
    "compose",
    "@caperjs/core",
    "caper"
  ],
  "version": "0.6.1",
  "files": [
    "lib",
    "src"
  ],
  "main": "lib/caper-plugin-solid.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "default": "./lib/caper-plugin-solid.mjs",
      "types": "./lib/index.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run generate-version && vite build",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-version": "node generateVersion.mjs"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@caperjs/core": "workspace:^",
    "happy-dom": "^15",
    "solid-js": "^1.9.0",
    "vite": "^8.0.7",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3"
  },
  "peerDependencies": {
    "@caperjs/core": "^0.6.1",
    "gsap": "^3.13.0",
    "pixi.js": "8.20.0",
    "solid-js": "^1.9.0"
  }
}
