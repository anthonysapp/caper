{
  "name": "@caperjs/solid",
  "description": "Declarative Solid JSX view layer for Caper",
  "keywords": [
    "solid",
    "solid-js",
    "jsx",
    "compose",
    "@caperjs/core",
    "caper"
  ],
  "version": "0.7.0",
  "files": [
    "lib",
    "src",
    "jsx.d.ts",
    "vite.mjs",
    "vite.d.mts",
    "!src/__typefixtures__"
  ],
  "main": "lib/caper-plugin-solid.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/caper-plugin-solid.mjs"
    },
    "./jsx": {
      "types": "./jsx.d.ts"
    },
    "./vite": {
      "types": "./vite.d.mts",
      "default": "./vite.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run generate-version && vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "test": "vitest run && pnpm run test:types",
    "test:types": "node checkJsxTypes.mjs",
    "test:watch": "vitest",
    "generate-version": "node generateVersion.mjs"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@caperjs/core": "workspace:^",
    "gsap": "^3.13.0",
    "happy-dom": "^15",
    "solid-js": "^1.9.0",
    "vite": "^8.0.7",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3"
  },
  "dependencies": {
    "vite-plugin-solid": "^2.11.0"
  },
  "peerDependencies": {
    "@caperjs/core": "^0.7.0",
    "gsap": "^3.13.0",
    "pixi.js": "8.20.0",
    "solid-js": "^1.9.0"
  }
}
